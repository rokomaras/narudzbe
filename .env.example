# Kopiraj u .env (ne ide u git):  cp .env.example .env
POSTGRES_DB=narudzbe
POSTGRES_USER=narudzbe_user
POSTGRES_PASSWORD=narudzbe_pass
DB_PORT=5432

# postgresql+asyncpg://<user>:<pass>@<host>:<port>/<db>
DATABASE_URL=postgresql+asyncpg://narudzbe_user:narudzbe_pass@localhost:5432/narudzbe
ENV=dev
# U produkciji OBAVEZNO promijeni: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=change-me-in-production
JWT_ISSUER=narudzbe-api
# Lozinka admin korisnika koju postavlja seed skripta
ADMIN_PASSWORD=admin123
# Dopušteni frontend origini (zarezom odvojeni). Prazno = localhost:5173
CORS_ORIGINS=
